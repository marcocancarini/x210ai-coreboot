# 51NB X210AI, Core Ultra 7 165H (Meteor Lake) - SPERIMENTALE, MAI AVVIATA
#
# Variante Heads del port coreboot di questa repo, con TPM 2.0 di PTT (CRB).
# Base: boards/novacustom-v540tu, l'unica scheda Meteor Lake di Heads.
#
# Differenze dalla v540tu:
#  - coreboot dal fork WheeledCord/coreboot-x210ai con le patch della repo
#    (luminosita', Thunderbolt RP1, TPM PTT) e microcode 0x2b come file esterno;
#  - TPM: PTT nel ME via CRB, non un TPM discreto: kernel con CONFIG_TCG_CRB;
#  - /boot su btrfs: kernel con CONFIG_BTRFS_FS;
#  - niente EC Dasharo, niente GbE (nessuna regione GbE nel descriptor),
#    quindi niente randomizzazione del MAC;
#  - FLASH_OPTIONS solo sulla regione BIOS. La regione ME contiene Boot Guard
#    disattivato e il descriptor e' quello originale: Heads non deve toccarli;
#  - niente PR0 al primo giro, cosi' da Linux si puo' ancora riscrivere la ROM
#    edk2 con flashrom. Da attivare solo dopo prove riuscite.
export CONFIG_COREBOOT=y
export CONFIG_COREBOOT_VERSION=x210ai
export CONFIG_LINUX_VERSION=6.1.8

CONFIG_COREBOOT_CONFIG=config/coreboot-x210ai.config
CONFIG_LINUX_CONFIG=config/linux-x210ai.config

#On-demand hardware support (modules.cpio)
CONFIG_LINUX_USB=y

#Modules packed into tools.cpio
CONFIG_CRYPTSETUP2=y
CONFIG_FLASHPROG=y
CONFIG_FLASHTOOLS=y
CONFIG_GPG2=y
CONFIG_KEXEC=y
CONFIG_UTIL_LINUX=y
CONFIG_LVM2=y
CONFIG_MBEDTLS=y
CONFIG_PCIUTILS=y

#platform locking finalization (PR0): spento finche' la variante non e' provata
export CONFIG_FINALIZE_PLATFORM_LOCKING=n

#Remote attestation support
# TPM2 requirements
CONFIG_TPM2_TSS=y
CONFIG_OPENSSL=y
#Remote Attestation common tools
CONFIG_POPT=y
CONFIG_QRENCODE=y
CONFIG_TPMTOTP=y
#HOTP based remote attestation for supported USB Security dongle
CONFIG_HOTPKEY=y
#FBWhiptail based (Graphical):
CONFIG_CAIRO=y
CONFIG_FBWHIPTAIL=y

#Runtime configuration
export CONFIG_AUTO_BOOT_TIMEOUT=5
#TPM2 requirements
export CONFIG_TPM2_TOOLS=y
export CONFIG_PRIMARY_KEY_TYPE=ecc
#Enable DEBUG output: acceso, la variante non e' mai stata avviata
export CONFIG_DEBUG_OUTPUT=y
export CONFIG_ENABLE_FUNCTION_TRACING_OUTPUT=n
export CONFIG_TPM2_CAPTURE_PCAP=n
export CONFIG_QUIET_MODE=n
export CONFIG_BOOTSCRIPT=/bin/gui-init.sh
export CONFIG_BOOT_REQ_HASH=n
export CONFIG_BOOT_REQ_ROLLBACK=n
export CONFIG_BOOT_KERNEL_ADD=""
export CONFIG_BOOT_KERNEL_REMOVE=""
export CONFIG_BOARD_NAME="51NB X210AI (sperimentale)"
export CONFIG_FLASH_TOOL="flashprog --progress --programmer internal"
export CONFIG_FLASH_OPTIONS="${CONFIG_FLASH_TOOL} --ifd -i bios"
